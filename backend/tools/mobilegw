#!/usr/bin/env python3
"""Phone transport backed by mobileq. DSH's authenticated /mobile bridge is the public entry."""
import base64
import hmac
import json
import os
import sqlite3
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

# MOBILEGW_STATE 让一个后端把 gateway 指到它自己的状态目录：两套队伍（例如 desktop 与 web）各自持有队列和 token，
# 而不是抢同一份。不设时仍落到历史默认位置，老部署的行为一字不变。
STATE = os.environ.get('MOBILEGW_STATE') or os.path.join(
    os.environ.get('DSH_HOME') or os.path.expanduser('~/.dsh'), 'state', 'superagent')
DB = os.path.join(STATE, 'mobileq.db')
TOKEN_FILE = os.path.join(STATE, 'mobilegw.token')
PORT = int(os.environ.get('MOBILEGW_PORT', '8788'))
BIND = os.environ.get('MOBILEGW_HOST', '127.0.0.1')
CONV = os.environ.get('MOBILEGW_CONV', 'main')
MAX_BODY = 64 * 1024


def load_token():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    try:
        with open(TOKEN_FILE) as stream:
            token = stream.read().strip()
        if token:
            return token
    except FileNotFoundError:
        pass
    token = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip('=')
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as stream:
        stream.write(token)
    return token


TOKEN = load_token()


def db():
    c = sqlite3.connect(DB, timeout=10)
    c.row_factory = sqlite3.Row
    c.execute('''CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY AUTOINCREMENT,conversation TEXT NOT NULL,
        thread INTEGER,sender TEXT NOT NULL,bot INTEGER DEFAULT 0,mentions_me INTEGER DEFAULT 0,
        mentions TEXT,text TEXT NOT NULL,at TEXT NOT NULL,url TEXT,reply_to INTEGER)''')
    c.execute('''CREATE TABLE IF NOT EXISTS replies(id INTEGER PRIMARY KEY AUTOINCREMENT,conversation TEXT NOT NULL,
        to_msg INTEGER,rkey TEXT UNIQUE,text TEXT NOT NULL,at TEXT NOT NULL,bot_id TEXT)''')
    columns = {row[1] for row in c.execute('PRAGMA table_info(messages)')}
    if 'request_id' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN request_id TEXT')
    if 'mentions' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN mentions TEXT')
    # A message stops being withdrawable once a Source has pulled it (`read_at`) or a reply hangs
    # under it. `withdrawn_at` keeps the row so the same request_id cannot quietly reappear.
    if 'read_at' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN read_at TEXT')
    if 'withdrawn_at' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN withdrawn_at TEXT')
    if 'bot_id' not in {row[1] for row in c.execute('PRAGMA table_info(replies)')}:
        c.execute('ALTER TABLE replies ADD COLUMN bot_id TEXT')
    c.execute('CREATE UNIQUE INDEX IF NOT EXISTS messages_request_id ON messages(conversation, request_id)')
    c.commit()
    return c


def now():
    return time.strftime('%Y-%m-%dT%H:%M:%S%z')


def tie_key(value):
    """One comparable form of a reply's parent, whether it is a message number or a text id."""
    return '' if value is None else str(value)


class H(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _auth(self):
        return hmac.compare_digest(self.headers.get('X-GW-Token', '').encode(), TOKEN.encode())

    def _send(self, code, obj):
        data = json.dumps(obj, ensure_ascii=False).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(data)

    def _body(self):
        """Decode the JSON body. On a client error answer here and return (False, None)."""
        try:
            length = int(self.headers.get('Content-Length', '0'))
        except ValueError:
            self._send(400, {'error': 'invalid content length'})
            return False, None
        if length < 0 or length > MAX_BODY:
            self._send(413, {'error': 'request too large'})
            return False, None
        try:
            return True, json.loads(self.rfile.read(length))
        except (ValueError, UnicodeDecodeError):
            self._send(400, {'error': 'invalid JSON'})
            return False, None

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == '/health':
            return self._send(200, {'ok': True})
        if not self._auth():
            return self._send(401, {'error': 'unauthorized'})
        if path != '/timeline':
            return self._send(404, {'error': 'not found'})
        c = db()
        try:
            # A withdrawn message is gone from the conversation: it never reached a worker, so the
            # phone must neither show it nor keep offering it in `queued`.
            msgs = c.execute('SELECT id,text,sender,at,request_id,mentions FROM messages WHERE conversation=? AND withdrawn_at IS NULL ORDER BY id', (CONV,)).fetchall()
            reps = c.execute('SELECT id,to_msg,text,at,bot_id FROM replies WHERE conversation=? ORDER BY id', (CONV,)).fetchall()
        finally:
            c.close()
        entries = [(m['id'], 0, m['id'], {'role': 'user', 'text': m['text'], 'at': m['at'],
                    'id': 'm%d' % m['id'], 'request_id': m['request_id'],
                    'mentions': [x for x in ((m['mentions'] or '').split(',')) if x]}) for m in msgs]
        entries += [(r['to_msg'] or 0, 1, r['id'], {'role': 'agent', 'text': r['text'],
                     'at': r['at'], 'id': 'r%d' % r['id'],
                     # 回复挂在哪条消息下要交给客户端：没有它，界面分不清哪句在回哪句，
                     # `queued` 也没法判断一条消息是不是已经被答过了。
                     **({'bot_id': r['bot_id']} if r['bot_id'] else {}),
                     **({'reply_to': 'm%d' % r['to_msg']} if isinstance(r['to_msg'], int) else
                        ({'reply_to': r['to_msg']} if r['to_msg'] else {}))})
                    for r in reps]
        # 按发生时间排，而不是按「挂在哪条消息下」分组：分组会把 23:47 那条的回复
        # 排到 23:54 的消息之前，屏幕上就成了「回答和消息对不上」。
        # at 是同一格式的带偏移时间串，可直接比较；同一秒内用户消息在前、回复在后。
        entries.sort(key=lambda item: (item[3]['at'], item[1], tie_key(item[2])))
        return self._send(200, {'items': [item[3] for item in entries]})

    def _claim(self):
        """Take a message out of the queue for a steer without answering it.

        A steer is the owner jumping the line: the text goes straight to the running worker's next
        step, so the queue must not hand the same message to the router later. Marking it read is
        what `pull` already does; this endpoint just does it for one request id and returns the text.
        Answering is a different thing: a replied message cannot be claimed.
        """
        ok, body = self._body()
        if not ok:
            return
        request_id = body.get('request_id') if isinstance(body, dict) else None
        if not isinstance(request_id, str) or not request_id or len(request_id) > 128:
            return self._send(400, {'error': 'request_id is required'})
        c = db()
        try:
            row = c.execute('SELECT id,text,read_at,withdrawn_at FROM messages WHERE conversation=? AND request_id=?',
                            (CONV, request_id)).fetchone()
            if not row or row['withdrawn_at']:
                return self._send(404, {'error': 'no such message'})
            answered = c.execute('SELECT 1 FROM replies WHERE conversation=? AND to_msg=? LIMIT 1', (CONV, row['id'])).fetchone()
            if answered:
                return self._send(409, {'error': 'message was already answered'})
            if row['read_at']:
                return self._send(409, {'error': 'message was already picked up'})
            c.execute('BEGIN IMMEDIATE')
            c.execute('UPDATE messages SET read_at=datetime(\'now\') WHERE id=? AND read_at IS NULL', (row['id'],))
            c.commit()
            return self._send(200, {'ok': True, 'id': row['id'], 'request_id': request_id, 'text': row['text']})
        finally:
            c.close()

    def do_POST(self):
        path = urlsplit(self.path).path
        if not self._auth():
            return self._send(401, {'error': 'unauthorized'})
        if path == '/withdraw':
            return self._withdraw()
        if path == '/claim':
            return self._claim()
        if path != '/send':
            return self._send(404, {'error': 'not found'})
        ok, body = self._body()
        if not ok:
            return
        if not isinstance(body, dict) or not isinstance(body.get('text'), str) or not body['text'].strip():
            return self._send(400, {'error': 'text must be a nonempty string'})
        if body.get('sender', 'owner') != 'owner':
            return self._send(400, {'error': 'sender cannot be overridden'})
        mentions = body.get('mentions') or []
        if not isinstance(mentions, list) or not all(isinstance(m, str) and m for m in mentions):
            return self._send(400, {'error': 'mentions must be a list of bot ids'})
        if len(mentions) > 10:
            return self._send(400, {'error': 'too many mentions'})
        text, request_id = body['text'].strip(), body.get('request_id')
        if request_id is not None and (not isinstance(request_id, str) or not request_id or len(request_id) > 128):
            return self._send(400, {'error': 'invalid request_id'})
        c = db()
        try:
            c.execute('BEGIN IMMEDIATE')
            existing = c.execute('SELECT id,text FROM messages WHERE conversation=? AND request_id=?', (CONV, request_id)).fetchone() if request_id else None
            if existing:
                if existing['text'] != text:
                    return self._send(409, {'error': 'request_id already used for a different message'})
                mid = existing['id']
            else:
                # Distinct dispatch threads let the router decide whether this is
                # new work or a follow-up; one shared thread would fan every new
                # request into whichever old Ticket subscribed to that thread.
                # `steer` means this message went straight to a running worker: insert it
                # already read, so `pull` never routes the same text a second time.
                stamp = now() if body.get('steer') is True else None
                cursor = c.execute('INSERT INTO messages(conversation,thread,sender,bot,mentions_me,mentions,text,at,request_id,read_at) VALUES(?,?,?,?,?,?,?,?,?,?)',
                                   (CONV, None, 'owner', 0, 1, ','.join(mentions), text, now(), request_id, stamp))
                mid = cursor.lastrowid
            c.commit()
        finally:
            c.close()
        return self._send(200, {'ok': True, 'id': mid, 'request_id': request_id})

    def _withdraw(self):
        """Take back a message nobody has consumed yet.

        A message is still withdrawable only while both things are true: no reply hangs under it
        (it was answered) and no Source has pulled it (`read_at` is empty). Once either happened the
        work is already in flight, so deleting it would silently disagree with the worker. Refuse
        instead, and keep the row behind `withdrawn_at` so the same request_id cannot come back.
        """
        ok, body = self._body()
        if not ok:
            return
        request_id = body.get('request_id') if isinstance(body, dict) else None
        if not isinstance(request_id, str) or not request_id or len(request_id) > 128:
            return self._send(400, {'error': 'invalid request_id'})
        c = db()
        try:
            # One writer at a time: a Source's pull and this check must not interleave, or a message
            # could be withdrawn after the worker has already been handed it.
            c.execute('BEGIN IMMEDIATE')
            row = c.execute('SELECT id,read_at,withdrawn_at FROM messages WHERE conversation=? AND request_id=?',
                            (CONV, request_id)).fetchone()
            if row is None:
                c.rollback()
                return self._send(404, {'error': 'no such message'})
            if row['withdrawn_at']:
                c.rollback()
                return self._send(409, {'error': 'message already withdrawn'})
            if c.execute('SELECT 1 FROM replies WHERE conversation=? AND to_msg=? LIMIT 1',
                         (CONV, row['id'])).fetchone():
                c.rollback()
                return self._send(409, {'error': 'message was already answered'})
            if row['read_at']:
                c.rollback()
                return self._send(409, {'error': 'message was already picked up'})
            c.execute('UPDATE messages SET withdrawn_at=? WHERE id=?', (now(), row['id']))
            c.commit()
        except Exception:
            c.rollback()
            raise
        finally:
            c.close()
        return self._send(200, {'ok': True, 'id': row['id'], 'request_id': request_id})


if __name__ == '__main__':
    # Initialize/migrate before accepting concurrent HTTP requests. Never log credentials.
    db().close()
    print('mobilegw on %s:%d conv=%s' % (BIND, PORT, CONV), flush=True)
    ThreadingHTTPServer((BIND, PORT), H).serve_forever()
