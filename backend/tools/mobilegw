    # 先判归属，再碰数据库、再 bind：一次没写全的启动必须在「还不知道自己是谁」的时候就停下。
    PORT, PROBLEM = check_binding()
    if PROBLEM:
        print(PROBLEM, file=sys.stderr, flush=True)
        raise SystemExit(2)
    # Initialize/migrate before accepting concurrent HTTP requests. Never log credentials.
    db().close()
    # 先落所有权记录再报启动行：读启动行的一方（台架、测试）应当能立刻读到它。
    write_owner(PORT)
    # 启动行只说「凭据在哪一支」和「谁在守着这个端口」，不说凭据本身 —— 2026-11-06 那版把 token 打进了
    # 一个 0644 的日志，值至今有效。要查用的哪一支，看路径；要验它通不通，发一次请求。
    print('mobilegw on %s:%d conv=%s session_api=1 state=%s token_file=%s'
          % (BIND, PORT, DEFAULT_SESSION, os.path.realpath(STATE), TOKEN_FILE), flush=True)
    try:
        ThreadingHTTPServer((BIND, PORT), H).serve_forever()
    except OSError as error:
        # 端口被别人占着就是别人占着：这里既不重试换端口，也不去动那个进程。
        print('mobilegw cannot bind %s:%d: port already in use (%s). '
              'Nothing was killed; pick another MOBILEGW_PORT.' % (BIND, PORT, error),
              file=sys.stderr, flush=True)
        raise SystemExit(1)

