#!/usr/bin/env python3
"""Phone transport backed by mobileq. DSH's authenticated /mobile bridge is the public entry."""
import base64
import hmac
import json
import os
import re
import sqlite3
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from gateway_binding import binding_problem, parse_port  # noqa: E402  (same directory, script not a package)

# MOBILEGW_STATE 让一个后端把 gateway 指到它自己的状态目录：两套队伍（例如 desktop 与 web）各自持有队列和 token，
# 而不是抢同一份。不设时仍落到历史默认位置，老部署的行为一字不变。
STATE = os.environ.get('MOBILEGW_STATE') or os.path.join(
    os.environ.get('DSH_HOME') or os.path.expanduser('~/.dsh'), 'state', 'superagent')
DB = os.path.join(STATE, 'mobileq.db')
TOKEN_FILE = os.path.join(STATE, 'mobilegw.token')
# 端口与状态目录是**一对**：端口不是缺省值，而是这台网关属于谁的声明。没给就是没声明（见 gateway_binding）。
PORT_TEXT = os.environ.get('MOBILEGW_PORT', '').strip()
BIND = os.environ.get('MOBILEGW_HOST', '127.0.0.1')
OWNER_FILE = os.path.join(STATE, 'mobilegw.owner')
# 会话必须是请求级的：进程级常量会把两个会话静默并进同一条时间线。`main` 是唯一缺省值（契约 §1）。
DEFAULT_SESSION = 'main'
SESSION_RE = re.compile(r'[a-z0-9][a-z0-9-]{0,31}')
# header 形态（契约 §1 / #14 第 2 项）：与 x-crew-device / x-crew-credential 同族的小写头名。
# query 优先、header 兜底；两者都给且不一致一律 400 invalid_session，不许猜哪个算数。
SESSION_HEADER = 'x-crew-session'
MAX_BODY = 64 * 1024


def load_token():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    try:
        with open(TOKEN_FILE) as stream:
            token = stream.read().strip()
        if token:
            return token
    except FileNotFoundError:
        pass
    token = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip('=')
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as stream:
        stream.write(token)
    return token


TOKEN = load_token()


def current_token():
    """The credential to compare against, re-read from disk so a rotation takes effect without a restart.

    原先 TOKEN 是模块级常量：换掉 `<stateDir>/mobilegw.token` 之后，网关仍然只认旧值，直到有人
    重启它 —— 而重启生产网关是不许做的动作。凭据的真理源是那个文件，不是进程启动那一刻的快照，
    所以每次校验都读它。

    读失败或读成空值就退回启动时那份：文件被临时挪走不该让所有已配对的手机一起掉线；那种情况下
    保持原值比 fail-closed 更接近「什么都没发生」。真正换掉文件时，新值立刻生效、旧值立刻失效。
    """
    try:
        with open(TOKEN_FILE) as stream:
            token = stream.read().strip()
    except OSError:
        return TOKEN
    return token or TOKEN


def check_binding():
    """Refuse to start without an explicit port, or on the production gateway's own port.

    判据全部在 `gateway_binding.binding_problem` 里（纯函数、可单测）。这里只负责把结论翻译成
    (port, error)：error 非空时调用方必须以退出码 2 结束，且不 bind、不写 owner 记录。
    """
    problem = binding_problem(PORT_TEXT, STATE)
    if problem:
        return None, problem
    return parse_port(PORT_TEXT), None


def write_owner(port):
    """Record who owns this process, so a later cleanup can check before it signals anything.

    带 pid + 启动时刻 + 状态目录 + 端口：pid 会被系统回收，只凭 pid 去 kill 可能杀到别人的新进程。
    **不写凭据值**，也不写任何能反推出凭据的东西。

    这里不写「是不是 launchd 托管的」：`XPC_SERVICE_NAME` 会被 launchd 的子进程继承，任何在
    launchd 会话里起的网关都会带上它，写下来就是一条会误导人的断言。谁守着哪个端口，由
    「端口 + 状态目录」这一对回答（见 check_binding）。
    """
    record = {'pid': os.getpid(), 'parent': os.getppid(), 'port': port, 'host': BIND,
              'state': os.path.realpath(STATE), 'started_at': int(time.time())}
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    temporary = OWNER_FILE + '.tmp'
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as stream:
        json.dump(record, stream, ensure_ascii=False)
        stream.write('\n')
    os.replace(temporary, OWNER_FILE)


def db():
    c = sqlite3.connect(DB, timeout=10)
    c.row_factory = sqlite3.Row
    c.execute('''CREATE TABLE IF NOT EXISTS messages(id INTEGER PRIMARY KEY AUTOINCREMENT,conversation TEXT NOT NULL,
        thread INTEGER,sender TEXT NOT NULL,bot INTEGER DEFAULT 0,mentions_me INTEGER DEFAULT 0,
        mentions TEXT,text TEXT NOT NULL,at TEXT NOT NULL,url TEXT,reply_to INTEGER)''')
    c.execute('''CREATE TABLE IF NOT EXISTS replies(id INTEGER PRIMARY KEY AUTOINCREMENT,conversation TEXT NOT NULL,
        to_msg INTEGER,rkey TEXT UNIQUE,text TEXT NOT NULL,at TEXT NOT NULL,bot_id TEXT,kind TEXT)''')
    columns = {row[1] for row in c.execute('PRAGMA table_info(messages)')}
    if 'request_id' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN request_id TEXT')
    if 'mentions' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN mentions TEXT')
    # A message stops being withdrawable once a Source has pulled it (`read_at`) or a reply hangs
    # under it. `withdrawn_at` keeps the row so the same request_id cannot quietly reappear.
    if 'read_at' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN read_at TEXT')
    if 'withdrawn_at' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN withdrawn_at TEXT')
    if 'bot_id' not in {row[1] for row in c.execute('PRAGMA table_info(replies)')}:
        c.execute('ALTER TABLE replies ADD COLUMN bot_id TEXT')
    # 出站类型：'acknowledgement' / 'reply' / 'notice'，NULL = 本列之前写的历史行。
    # 网关只转述这一列，绝不由正文猜类型（回执与最终答复必须能分开）。
    if 'kind' not in {row[1] for row in c.execute('PRAGMA table_info(replies)')}:
        c.execute('ALTER TABLE replies ADD COLUMN kind TEXT')
    c.execute('CREATE UNIQUE INDEX IF NOT EXISTS messages_request_id ON messages(conversation, request_id)')
    c.commit()
    return c


def now():
    return time.strftime('%Y-%m-%dT%H:%M:%S%z')


def tie_key(value):
    """One comparable form of a reply's parent, whether it is a message number or a text id."""
    return '' if value is None else str(value)


def resolve_session(handler):
    """Pure read of THIS request's session field: (session, explicit). No I/O.

    query 优先、header 兜底（契约 §1 的 header 形态）。两者都给且值不一致 -> (None, True)：
    **绝不猜哪个算数**, 调用方一律回 400 invalid_session。两者都没给 -> (main, False)：
    老调用，响应一个字段都不加、逐字不变。形状非法 / 同名 header 给了两个不同值 ->
    (None, True)，同样是 400 而不是回落 main。`fullmatch`（不是 `$`）连带挡住尾部换行。

    #14 字面写「header 未被识别时按缺省 main，不得报错」。按字面做会重新引入 C4 静默串线：
    老网关不读 header，客户端以为在 work 会话、消息却 200 写进 main，全程无报错 —— 契约
    §9.5 / ADR 0007 判定的「唯一危险组合」。裁决：那句只对「老客户端压根不发这个 header」
    成立（下面的 session is None 分支）；「新客户端发了 header 但对端不认」必须由消息面 /
    客户端的能力位先验挡成 409 unsupported_session 或零发出，绝不降级成 200。所以这里
    header 一旦出现就必须被识别、必须校验、必须冲突报错，绝不静默吞掉按 main 落库。
    """
    values = parse_qs(urlsplit(handler.path).query, keep_blank_values=True).get('session_id')
    query = values[0] if values else None
    # get_all 而不是 get：同名 header 出现两次且值不同也是「两者不一致」，不许取第一个猜。
    raw_headers = handler.headers.get_all(SESSION_HEADER) or []
    header_values = list(dict.fromkeys(raw_headers))
    if len(header_values) > 1:
        return None, True
    header = header_values[0] if header_values else None
    if query is not None and header is not None and query != header:
        return None, True
    session = query if query is not None else header
    if session is None:
        return DEFAULT_SESSION, False
    if not SESSION_RE.fullmatch(session):
        return None, True
    return session, True


def session_of(handler):
    """The conversation for THIS request. Invalid/conflicting -> 400 invalid_session + None.

    Missing -> `main`, so a legacy caller keeps seeing exactly the old rows. None tells the
    caller to stop before it touches the database; no row is ever written under `main` for a
    request that explicitly named a session (C4 串线的入口).
    """
    session, _explicit = resolve_session(handler)
    if session is None:
        handler._send(400, {'error': 'invalid_session'})
        return None
    return session


class H(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _auth(self):
        return hmac.compare_digest(self.headers.get('X-GW-Token', '').encode(), current_token().encode())

    def _send(self, code, obj):
        # 能力位覆盖**所有**响应，而不只是 timeline：消息面据此在任何 operation 上判断
        # 对端是不是老网关。否则客户端不先取 timeline 就直发 send?session_id=work 时，
        # 老网关会把消息静默按 main 落库，消息面也无从发现（S1 契约最在意的串线）。
        #
        # 判据与 session_of 共用 resolve_session 一处逻辑：query 或 header 任一形态显式
        # 带了会话，所有响应都回显 session_id + session_api:1（契约 §1 header 形态）。
        # 老调用（既无 query 也无 header）一个字段都不加，逐字不变；冲突 / 非法值已被
        # session_of 回过 400，这里 resolve 返回 None 同样不加 —— 那个 400 响应必须逐字
        # 是 {'error': 'invalid_session'}，不能被消息面误读成一次成功的能力协商。
        # timeline 自带这两个字段，setdefault 不覆盖它。
        if isinstance(obj, dict):
            session, explicit = resolve_session(self)
            if explicit and session is not None:
                obj.setdefault('session_id', session)
                obj.setdefault('session_api', 1)
        data = json.dumps(obj, ensure_ascii=False).encode('utf-8')
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(data)

    def _body(self):
        """Decode the JSON body. On a client error answer here and return (False, None)."""
        try:
            length = int(self.headers.get('Content-Length', '0'))
        except ValueError:
            self._send(400, {'error': 'invalid content length'})
            return False, None
        if length < 0 or length > MAX_BODY:
            self._send(413, {'error': 'request too large'})
            return False, None
        try:
            return True, json.loads(self.rfile.read(length))
        except (ValueError, UnicodeDecodeError):
            self._send(400, {'error': 'invalid JSON'})
            return False, None

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == '/health':
            # 探针不消费会话，但非法值仍按契约 §1 拒绝，不留一个静默放行口。
            if session_of(self) is None:
                return
            return self._send(200, {'ok': True})
        if not self._auth():
            return self._send(401, {'error': 'unauthorized'})
        session = session_of(self)
        if session is None:
            return
        if path == '/meta':
            return self._meta(session)
        if path != '/timeline':
            return self._send(404, {'error': 'not found'})
        c = db()
        try:
            # A withdrawn message is gone from the conversation: it never reached a worker, so the
            # phone must neither show it nor keep offering it in `queued`.
            # `read_at` 一起读出来：它是「队伍已经读走」的唯一持久记录。手机面靠它算
            # 「发出去还没被读走」的条数（契约 §5.6）。撤回只看它有没有值，这里不改那套判定。
            msgs = c.execute('SELECT id,text,sender,at,request_id,mentions,read_at FROM messages WHERE conversation=? AND withdrawn_at IS NULL ORDER BY id', (session,)).fetchall()
            reps = c.execute('SELECT id,to_msg,text,at,bot_id,kind FROM replies WHERE conversation=? ORDER BY id', (session,)).fetchall()
        finally:
            c.close()
        entries = [(m['id'], 0, m['id'], {'role': 'user', 'text': m['text'], 'at': m['at'],
                    'id': 'm%d' % m['id'], 'request_id': m['request_id'],
                    # 空串=还没被读走；有值=队伍取走了（pull 或 claim 那一刻）。
                    # 键永远在：缺席会被读成「这条读没读，网关没说」，那是另一件事。
                    'read_at': m['read_at'] or '',
                    'mentions': [x for x in ((m['mentions'] or '').split(',')) if x]}) for m in msgs]
        entries += [(r['to_msg'] or 0, 1, r['id'], {'role': 'agent', 'text': r['text'],
                     'at': r['at'], 'id': 'r%d' % r['id'],
                     # 回复挂在哪条消息下要交给客户端：没有它，界面分不清哪句在回哪句，
                     # `queued` 也没法判断一条消息是不是已经被答过了。
                     **({'bot_id': r['bot_id']} if r['bot_id'] else {}),
                     # 回执 / 最终答复 / 通知三选一；历史缺失就**缺着**，客户端不据此显示「已回复」。
                     **({'reply_kind': r['kind']} if r['kind'] else {}),
                     **({'reply_to': 'm%d' % r['to_msg']} if isinstance(r['to_msg'], int) else
                        ({'reply_to': r['to_msg']} if r['to_msg'] else {}))})
                    for r in reps]
        # 按发生时间排，而不是按「挂在哪条消息下」分组：分组会把 23:47 那条的回复
        # 排到 23:54 的消息之前，屏幕上就成了「回答和消息对不上」。
        # at 是同一格式的带偏移时间串，可直接比较；同一秒内用户消息在前、回复在后。
        entries.sort(key=lambda item: (item[3]['at'], item[1], tie_key(item[2])))
        return self._send(200, {'items': [item[3] for item in entries],
                                'session_id': session, 'session_api': 1})

    def _meta(self, session):
        """Lightweight request metadata: ids, request_ids, read state, answer kinds.

        The live-activity snapshot must key items by the client's own `request_id`, and must not
        pull message/reply bodies to do it. This is that bounded read: two EXISTS probes per row
        instead of the full text of every message and reply in the conversation.

        `answered` counts only a **final reply** (`kind` IS NULL, i.e. a legacy row, or `'reply'`).
        `acknowledged` says a non-final outbound message (acknowledgement/notice) hangs under it.
        """
        # 点名行（活跃票 / 正在评估的队列行）保证老活跃任务不会因为「不在最近 N 条里」而消失；
        # 其余补最近若干条已结束的，供客户端清掉过期 overlay。总量有界，不是全历史扫描。
        named = []
        for value in parse_qs(urlsplit(self.path).query).get('row', []):
            if value.isdigit() and int(value) > 0:
                named.append(int(value))
        named = sorted(set(named))[:200]
        c = db()
        try:
            recent = c.execute(
                """SELECT m.id AS id, m.request_id AS request_id, m.read_at AS read_at,
                   (m.thread IS NULL OR m.thread = m.id) AS is_root,
                   EXISTS(SELECT 1 FROM replies r WHERE r.conversation=m.conversation AND r.to_msg=m.id
                          AND (r.kind IS NULL OR r.kind = 'reply')) AS answered,
                   EXISTS(SELECT 1 FROM replies r WHERE r.conversation=m.conversation AND r.to_msg=m.id
                          AND r.kind IS NOT NULL AND r.kind <> 'reply') AS acknowledged
                   FROM messages m
                   WHERE m.conversation=? AND m.withdrawn_at IS NULL AND m.request_id IS NOT NULL
                   ORDER BY m.id DESC LIMIT 50""", (session,)
            ).fetchall()
            if named:
                placeholders = ','.join('?' * len(named))
                extra = c.execute(
                    """SELECT m.id AS id, m.request_id AS request_id, m.read_at AS read_at,
                       (m.thread IS NULL OR m.thread = m.id) AS is_root,
                       EXISTS(SELECT 1 FROM replies r WHERE r.conversation=m.conversation AND r.to_msg=m.id
                              AND (r.kind IS NULL OR r.kind = 'reply')) AS answered,
                       EXISTS(SELECT 1 FROM replies r WHERE r.conversation=m.conversation AND r.to_msg=m.id
                              AND r.kind IS NOT NULL AND r.kind <> 'reply') AS acknowledged
                       FROM messages m
                       WHERE m.conversation=? AND m.withdrawn_at IS NULL AND m.request_id IS NOT NULL
                         AND m.id IN (%s)""" % placeholders, (session, *named)
                ).fetchall()
                merged = {row['id']: row for row in recent}
                for row in extra:
                    merged[row['id']] = row
                rows = [merged[key] for key in sorted(merged)]
            else:
                rows = list(recent)
        finally:
            c.close()
        items = [{'id': 'm%d' % row['id'], 'request_id': row['request_id'],
                  'read_at': row['read_at'] or '', 'root': bool(row['is_root']),
                  'answered': bool(row['answered']), 'acknowledged': bool(row['acknowledged'])}
                 for row in reversed(rows)]
        return self._send(200, {'items': items, 'session_id': session, 'session_api': 1})

    def _claim(self, session):
        """Take a message out of the queue for a steer without answering it.

        A steer is the owner jumping the line: the text goes straight to the running worker's next
        step, so the queue must not hand the same message to the router later. Marking it read is
        what `pull` already does; this endpoint just does it for one request id and returns the text.
        Answering is a different thing: a replied message cannot be claimed.
        """
        ok, body = self._body()
        if not ok:
            return
        request_id = body.get('request_id') if isinstance(body, dict) else None
        if not isinstance(request_id, str) or not request_id or len(request_id) > 128:
            return self._send(400, {'error': 'request_id is required'})
        c = db()
        try:
            row = c.execute('SELECT id,text,read_at,withdrawn_at FROM messages WHERE conversation=? AND request_id=?',
                            (session, request_id)).fetchone()
            if not row or row['withdrawn_at']:
                return self._send(404, {'error': 'no such message'})
            answered = c.execute('SELECT 1 FROM replies WHERE conversation=? AND to_msg=? LIMIT 1', (session, row['id'])).fetchone()
            if answered:
                return self._send(409, {'error': 'message was already answered'})
            if row['read_at']:
                return self._send(409, {'error': 'message was already picked up'})
            c.execute('BEGIN IMMEDIATE')
            c.execute('UPDATE messages SET read_at=datetime(\'now\') WHERE id=? AND read_at IS NULL', (row['id'],))
            c.commit()
            return self._send(200, {'ok': True, 'id': row['id'], 'request_id': request_id, 'text': row['text']})
        finally:
            c.close()

    def do_POST(self):
        path = urlsplit(self.path).path
        if not self._auth():
            return self._send(401, {'error': 'unauthorized'})
        session = session_of(self)
        if session is None:
            return
        if path == '/withdraw':
            return self._withdraw(session)
        if path == '/claim':
            return self._claim(session)
        if path != '/send':
            return self._send(404, {'error': 'not found'})
        ok, body = self._body()
        if not ok:
            return
        if not isinstance(body, dict) or not isinstance(body.get('text'), str) or not body['text'].strip():
            return self._send(400, {'error': 'text must be a nonempty string'})
        if body.get('sender', 'owner') != 'owner':
            return self._send(400, {'error': 'sender cannot be overridden'})
        mentions = body.get('mentions') or []
        if not isinstance(mentions, list) or not all(isinstance(m, str) and m for m in mentions):
            return self._send(400, {'error': 'mentions must be a list of bot ids'})
        if len(mentions) > 10:
            return self._send(400, {'error': 'too many mentions'})
        text, request_id = body['text'].strip(), body.get('request_id')
        if request_id is not None and (not isinstance(request_id, str) or not request_id or len(request_id) > 128):
            return self._send(400, {'error': 'invalid request_id'})
        c = db()
        try:
            c.execute('BEGIN IMMEDIATE')
            existing = c.execute('SELECT id,text FROM messages WHERE conversation=? AND request_id=?', (session, request_id)).fetchone() if request_id else None
            if existing:
                if existing['text'] != text:
                    return self._send(409, {'error': 'request_id already used for a different message'})
                mid = existing['id']
            else:
                # Distinct dispatch threads let the router decide whether this is
                # new work or a follow-up; one shared thread would fan every new
                # request into whichever old Ticket subscribed to that thread.
                # `steer` means this message went straight to a running worker: insert it
                # already read, so `pull` never routes the same text a second time.
                stamp = now() if body.get('steer') is True else None
                cursor = c.execute('INSERT INTO messages(conversation,thread,sender,bot,mentions_me,mentions,text,at,request_id,read_at) VALUES(?,?,?,?,?,?,?,?,?,?)',
                                   (session, None, 'owner', 0, 1, ','.join(mentions), text, now(), request_id, stamp))
                mid = cursor.lastrowid
            c.commit()
        finally:
            c.close()
        return self._send(200, {'ok': True, 'id': mid, 'request_id': request_id})

    def _withdraw(self, session):
        """Take back a message nobody has consumed yet.

        A message is still withdrawable only while both things are true: no reply hangs under it
        (it was answered) and no Source has pulled it (`read_at` is empty). Once either happened the
        work is already in flight, so deleting it would silently disagree with the worker. Refuse
        instead, and keep the row behind `withdrawn_at` so the same request_id cannot come back.
        """
        ok, body = self._body()
        if not ok:
            return
        request_id = body.get('request_id') if isinstance(body, dict) else None
        if not isinstance(request_id, str) or not request_id or len(request_id) > 128:
            return self._send(400, {'error': 'invalid request_id'})
        c = db()
        try:
            # One writer at a time: a Source's pull and this check must not interleave, or a message
            # could be withdrawn after the worker has already been handed it.
            c.execute('BEGIN IMMEDIATE')
            row = c.execute('SELECT id,read_at,withdrawn_at FROM messages WHERE conversation=? AND request_id=?',
                            (session, request_id)).fetchone()
            if row is None:
                c.rollback()
                return self._send(404, {'error': 'no such message'})
            if row['withdrawn_at']:
                c.rollback()
                return self._send(409, {'error': 'message already withdrawn'})
            if c.execute('SELECT 1 FROM replies WHERE conversation=? AND to_msg=? LIMIT 1',
                         (session, row['id'])).fetchone():
                c.rollback()
                return self._send(409, {'error': 'message was already answered'})
            if row['read_at']:
                c.rollback()
                return self._send(409, {'error': 'message was already picked up'})
            c.execute('UPDATE messages SET withdrawn_at=? WHERE id=?', (now(), row['id']))
            c.commit()
        except Exception:
            c.rollback()
            raise
        finally:
            c.close()
        return self._send(200, {'ok': True, 'id': row['id'], 'request_id': request_id})


