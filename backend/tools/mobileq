#!/usr/bin/env python3
"""mobileq — local message queue CLI for the dsh-superagent `mobile` Source.

Contract (mirrors docs/008-cookbook.md's `hookq` example):
  mobileq pull   --after <n> --json        -> {"me": "agent", "items": [...], "next": <n>}
  mobileq reply  --conversation <c> --to <msgId> --key <key> --text <t>
  mobileq thread --conversation <c> --root <msgId> --json [--after <cursor>]
  mobileq inject --conversation <c> --sender <s> --text <t> [--mentions-me] [--mention <bot>]... [--thread <msgId>] [--bot]
  mobileq outbox --conversation <c> [--after <n>] --json   -> replies the agent wrote back

DB lives at $DSH_HOME/state/superagent/mobileq.db (override with --db).
This is the transport seam only; it knows nothing about dsh-superagent internals.
"""
import argparse
import json
import os
import re
import sqlite3
import sys
import time

ME = "agent"


def db_path(args):
    if getattr(args, "db", None):
        return args.db
    home = os.environ.get("DSH_HOME") or os.path.expanduser("~/.dsh")
    d = os.path.join(home, "state", "superagent")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "mobileq.db")


def conn(p):
    c = sqlite3.connect(p)
    c.row_factory = sqlite3.Row
    c.execute(
        """CREATE TABLE IF NOT EXISTS messages(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            conversation TEXT NOT NULL,
            thread INTEGER,
            sender TEXT NOT NULL,
            bot INTEGER DEFAULT 0,
            mentions_me INTEGER DEFAULT 0,
            text TEXT NOT NULL,
            at TEXT NOT NULL,
            url TEXT,
            reply_to INTEGER,
            mentions TEXT
        )"""
    )
    c.execute(
        """CREATE TABLE IF NOT EXISTS replies(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            conversation TEXT NOT NULL,
            to_msg INTEGER,
            rkey TEXT UNIQUE,
            text TEXT NOT NULL,
            at TEXT NOT NULL,
            bot_id TEXT
        )"""
    )
    columns = {row[1] for row in c.execute('PRAGMA table_info(messages)')}
    if 'request_id' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN request_id TEXT')
    if 'mentions' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN mentions TEXT')
    # `pull` stamps `read_at`, which is what tells the withdraw endpoint the worker has it.
    # `withdrawn_at` hides a message a person took back before anyone read it.
    if 'read_at' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN read_at TEXT')
    if 'withdrawn_at' not in columns:
        c.execute('ALTER TABLE messages ADD COLUMN withdrawn_at TEXT')
    if 'bot_id' not in {row[1] for row in c.execute('PRAGMA table_info(replies)')}:
        c.execute('ALTER TABLE replies ADD COLUMN bot_id TEXT')
    c.execute('CREATE UNIQUE INDEX IF NOT EXISTS messages_request_id ON messages(conversation, request_id)')
    c.commit()
    return c


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def msg_json(r):
    return {
        "id": r["id"],
        "conversation": r["conversation"],
        "thread": r["thread"] if r["thread"] is not None else r["id"],
        "sender": {"id": r["sender"], "bot": bool(r["bot"])},
        "mentions_me": bool(r["mentions_me"]),
        "mentions": [m for m in ((r["mentions"] or "").split(",") if r["mentions"] else []) if m],
        "text": r["text"],
        "at": r["at"],
        "url": r["url"] or "",
        "reply_to": r["reply_to"],
    }


def cmd_pull(c, args):
    after = int(args.after or 0)
    # One writer at a time: the withdraw check and this hand-over must not interleave, or a message
    # could be taken back after the worker has already received it.
    c.execute("BEGIN IMMEDIATE")
    rows = c.execute(
        # read_at 也是「不再交付」：claim 把一条消息交给插队路径后，pull 不能再送一遍。
        "SELECT * FROM messages WHERE id > ? AND withdrawn_at IS NULL AND read_at IS NULL ORDER BY id ASC", (after,)
    ).fetchall()
    items = [msg_json(r) for r in rows]
    # Handing a message to a Source is the read: stamping it here is what lets the withdraw
    # endpoint refuse with "already picked up" instead of guessing from age.
    if rows:
        c.execute(
            "UPDATE messages SET read_at=? WHERE read_at IS NULL AND id IN (%s)"
            % ",".join("?" * len(rows)),
            (now(), *[r["id"] for r in rows]),
        )
    # The cursor moves past withdrawn rows too: they will never be delivered, and re-scanning them
    # on every poll forever is the only other option. The write lock above keeps this MAX stable.
    last = c.execute("SELECT MAX(id) AS id FROM messages WHERE id > ?", (after,)).fetchone()["id"]
    c.commit()
    nxt = last if last is not None else after
    out = {"me": ME, "items": items, "next": nxt}
    print(json.dumps(out, ensure_ascii=False))
    return 0


class GoneTarget(ValueError):
    """The parent message existed but was withdrawn — exit 410 (gone), not a param bug."""


def reply_target(value, conversation, c):
    """The inbound **message** a reply hangs under, validated against the real queue.

    Contract (matches the MCP adapter's `to` and `get`'s id shape): a reply's parent is a
    plain message id — `m<N>` or pure digits `N`, N a positive integer — that **exists in
    `conversation`**. Anything else is a bad target and must write nothing:
      * a conversation name like `main` / `work` (NOT a message id) — the old code stripped a
        leading `m` so `main` became `ain` and was written to `replies.to_msg`, then reported
        `ok:true`; that is exactly the silent-corruption path this guards against;
      * a reply id `r<N>` (that is a reply, not an inbound message a reply can hang under);
      * negative / zero / leading-zero / non-numeric;
      * a message id that exists but belongs to **another** conversation, or does not exist, or
        was withdrawn (the last case raises `GoneTarget` → exit 410).
    Returns the int message id (the column stores it as INTEGER). Raises `ValueError` (exit 2)
    on any invalid target, so `cmd_reply` writes zero rows.
    """
    m = re.fullmatch(r"m(\d+)", value or "")
    digits = m.group(1) if m else (value if re.fullmatch(r"\d+", value or "") else None)
    if digits is None:
        raise ValueError(
            "reply --to must be an inbound message id m<N> or plain digits N (positive int); "
            "got %r (conversation names like 'main', reply ids like 'r1', negatives and non-numeric are rejected)" % (value,)
        )
    if not re.fullmatch(r"[1-9]\d*", digits):
        raise ValueError("reply --to message number must be a positive integer (no 0, no leading zero); got %r" % (value,))
    mid = int(digits)
    row = c.execute(
        "SELECT id, withdrawn_at FROM messages WHERE id=? AND conversation=?",
        (mid, conversation),
    ).fetchone()
    if row is None:
        raise ValueError(
            "reply target m%d is not a message in conversation %r (missing or in another conversation); "
            "refusing to write" % (mid, conversation)
        )
    if row["withdrawn_at"] is not None:
        # A withdrawn parent is "gone" (410), distinct from a malformed/foreign target (2): callers like
        # sendTeam already treat CLI exit 410 as `gone` and stop retrying, rather than failing the round.
        raise GoneTarget("reply target m%d was withdrawn from conversation %r" % (mid, conversation))
    return mid


def cmd_reply(c, args):
    if not args.conversation or not args.to or not args.key or args.text is None:
        print("missing reply target", file=sys.stderr)
        return 2
    try:
        to_msg = reply_target(args.to, args.conversation, c)
    except GoneTarget as e:
        print(str(e), file=sys.stderr)
        return 410
    except ValueError as e:
        # Bad parent / foreign / missing / non-message ref: write nothing, exit non-zero, name why.
        print(str(e), file=sys.stderr)
        return 2
    replayed = False
    try:
        c.execute(
            "INSERT INTO replies(conversation,to_msg,rkey,text,at,bot_id) VALUES(?,?,?,?,?,?)",
            (args.conversation, to_msg, args.key, args.text, now(), getattr(args, 'bot', None)),
        )
        c.commit()
    except sqlite3.IntegrityError:
        # Idempotent: this rkey already delivered a reply. Do NOT pretend a *different* payload was sent —
        # report it as a replay, with the reply that already exists (its text is NOT this call's text).
        replayed = True
    # Resolve the visible reply by the UNIQUE rkey — the stable one row for this key, whether this call
    # inserted it or replayed it. Exact SELECT in the same transaction right after commit means a caller
    # (messages-mcp) gets the stable client-visible r<N> without re-pulling and scanning the whole
    # conversation. Never affected by history length or a concurrent same-text reply.
    row = c.execute("SELECT id FROM replies WHERE rkey=? ORDER BY id LIMIT 1", (args.key,)).fetchone()
    print(json.dumps({"ok": True, "key": args.key, "id": ("r%d" % row["id"]) if row else None,
                      "replayed": replayed}, ensure_ascii=False))
    return 0


def cmd_thread(c, args):
    root = int(args.root)
    conv = args.conversation
    # Keep dispatch ownership per request, while giving the assessor the actual
    # preceding conversation (including bot replies). Never expose later human
    # requests as evidence for an earlier Trigger.
    rows = c.execute(
        'SELECT * FROM (SELECT * FROM messages WHERE conversation=? AND id<=? AND withdrawn_at IS NULL ORDER BY id DESC LIMIT 100) ORDER BY id',
        (conv, root),
    ).fetchall()
    ids = {r['id'] for r in rows}
    replies = c.execute('SELECT * FROM replies WHERE conversation=? ORDER BY id', (conv,)).fetchall()
    # Sort within each exchange, independent of second-resolution timestamps.
    entries = [(r['id'], 0, r['id'], msg_json(r)) for r in rows]
    entries += [(r['to_msg'], 1, r['id'], {
        'id': 'r%s' % r['id'], 'conversation': conv, 'thread': root,
        'sender': {'id': ME, 'bot': True}, 'mentions_me': False,
        'text': r['text'], 'at': r['at'],
        **({'bot_id': r['bot_id']} if r['bot_id'] else {}),
    }) for r in replies if r['to_msg'] in ids]
    entries.sort(key=lambda item: item[:3])
    items = [item[3] for item in entries]
    if args.after:
        position = next((i for i, item in enumerate(items) if str(item['id']) == args.after), None)
        if position is not None:
            items = items[position + 1:]
    print(json.dumps({"items": items, "next": ""}, ensure_ascii=False))
    return 0


def cmd_inject(c, args):
    c.execute(
        "INSERT INTO messages(conversation,thread,sender,bot,mentions_me,mentions,text,at,reply_to) VALUES(?,?,?,?,?,?,?,?,?)",
        (
            args.conversation,
            int(args.thread) if args.thread else None,
            args.sender,
            1 if args.bot else 0,
            1 if args.mentions_me else 0,
            ",".join(args.mention or []),
            args.text,
            now(),
            int(args.thread) if args.thread else None,
        ),
    )
    c.commit()
    mid = c.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
    print(json.dumps({"ok": True, "id": mid}, ensure_ascii=False))
    return 0


def cmd_conversations(c, args):
    """Distinct conversations, oldest-first by first message id. Read-only.

    The integration adapter (messages-mcp) needs the channel list that
    `/api/mobile/timeline` would render; the queue has no such command and the
    adapter must not read someone else's sqlite layout by hand. This is the one
    read command added for it — it never writes.
    """
    rows = c.execute(
        "SELECT conversation, MIN(id) AS first, COUNT(*) AS n FROM messages GROUP BY conversation ORDER BY first ASC"
    ).fetchall()
    items = [{"id": r["conversation"], "messages": r["n"]} for r in rows]
    print(json.dumps({"items": items}, ensure_ascii=False))
    return 0


def cmd_timeline(c, args):
    """Merged conversation view for one conversation: messages + replies in time order.

    This is the same shape `/api/mobile/timeline` renders (role user/agent, id m<N>/r<N>),
    so the integration adapter reads exactly what a desktop/mobile client displays.
    """
    conv = args.conversation
    msgs = c.execute(
        "SELECT id,text,sender,bot,at,read_at,withdrawn_at FROM messages WHERE conversation=? AND withdrawn_at IS NULL ORDER BY id",
        (conv,),
    ).fetchall()
    reps = c.execute(
        "SELECT id,to_msg,rkey,text,at,bot_id FROM replies WHERE conversation=? ORDER BY id", (conv,)
    ).fetchall()
    entries = [(m["at"], 0, m["id"], {
        "id": "m%d" % m["id"], "role": "user", "sender": m["sender"], "text": m["text"], "at": m["at"],
        "read_at": m["read_at"] or "", "bot": bool(m["bot"]),
    }) for m in msgs]
    entries += [(r["at"], 1, r["id"], {
        "id": "r%d" % r["id"], "role": "agent", "text": r["text"], "at": r["at"], "rkey": r["rkey"],
        "to_msg": r["to_msg"], **({"bot_id": r["bot_id"]} if r["bot_id"] else {}),
    }) for r in reps]
    entries.sort(key=lambda item: (item[0], item[1], item[2]))
    items = [item[3] for item in entries]
    if getattr(args, "limit", None):
        items = items[-int(args.limit):]
    print(json.dumps({"conversation": conv, "items": items}, ensure_ascii=False))
    return 0


def cmd_get(c, args):
    """One message or reply by its id, in one conversation. Read-only, exact primary-key lookup.

    The integration adapter needs to read a single `m<N>` / `r<N>` that may be arbitrarily old (older
    than any page window); a time/limit window would miss it and lie "no such message". Ids are
    constrained to `m<digits>` / `r<digits>` and always filtered by conversation, so this is a bounded
    primary-key read — it never exposes an arbitrary SQL/path to the tool caller.
    """
    conv = args.conversation
    mid = re.fullmatch(r"m(\d+)", args.id or "")
    rid = re.fullmatch(r"r(\d+)", args.id or "")
    if mid:
        r = c.execute(
            "SELECT id,text,sender,bot,at,read_at,withdrawn_at FROM messages WHERE id=? AND conversation=?",
            (int(mid.group(1)), conv),
        ).fetchone()
        if not r or r["withdrawn_at"] is not None:
            print(json.dumps({"item": None}, ensure_ascii=False))
            return 0
        item = {"id": "m%d" % r["id"], "role": "user", "sender": r["sender"], "text": r["text"],
                "at": r["at"], "read_at": r["read_at"] or "", "bot": bool(r["bot"])}
        print(json.dumps({"item": item}, ensure_ascii=False))
        return 0
    if rid:
        r = c.execute(
            "SELECT id,to_msg,rkey,text,at,bot_id FROM replies WHERE id=? AND conversation=?",
            (int(rid.group(1)), conv),
        ).fetchone()
        if not r:
            print(json.dumps({"item": None}, ensure_ascii=False))
            return 0
        item = {"id": "r%d" % r["id"], "role": "agent", "text": r["text"], "at": r["at"], "rkey": r["rkey"],
                "to_msg": r["to_msg"], **({"bot_id": r["bot_id"]} if r["bot_id"] else {})}
        print(json.dumps({"item": item}, ensure_ascii=False))
        return 0
    print("bad id (expect m<N> or r<N>)", file=sys.stderr)
    return 2


def cmd_outbox(c, args):
    after = int(args.after or 0)
    q = "SELECT * FROM replies WHERE id > ?"
    params = [after]
    if args.conversation:
        q += " AND conversation = ?"
        params.append(args.conversation)
    q += " ORDER BY id ASC"
    rows = c.execute(q, params).fetchall()
    items = [
        {"id": r["id"], "conversation": r["conversation"], "to_msg": r["to_msg"],
         "key": r["rkey"], "text": r["text"], "at": r["at"],
         **({"bot_id": r["bot_id"]} if r["bot_id"] else {})}
        for r in rows
    ]
    nxt = items[-1]["id"] if items else after
    print(json.dumps({"items": items, "next": nxt}, ensure_ascii=False))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="mobileq")
    ap.add_argument("--db", default=None)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("pull")
    p.add_argument("--db", default=argparse.SUPPRESS)
    p.add_argument("--after", default="0")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_pull)

    p = sub.add_parser("reply")
    p.add_argument("--db", default=argparse.SUPPRESS)
    p.add_argument("--conversation", required=True)
    p.add_argument("--to", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--text", required=True)
    p.add_argument("--bot", default=None, help="bot id that signs this reply (team Source)")
    p.set_defaults(func=cmd_reply)

    p = sub.add_parser("thread")
    p.add_argument("--db", default=argparse.SUPPRESS)
    p.add_argument("--conversation", required=True)
    p.add_argument("--root", required=True)
    p.add_argument("--json", action="store_true")
    p.add_argument("--after", default=None)
    p.set_defaults(func=cmd_thread)

    p = sub.add_parser("inject")
    p.add_argument("--conversation", required=True)
    p.add_argument("--sender", required=True)
    p.add_argument("--text", required=True)
    p.add_argument("--thread", default=None)
    p.add_argument("--mentions-me", action="store_true")
    p.add_argument("--mention", action="append", default=[],
                   help="bot id this message @-mentions; repeatable (team Source)")
    p.add_argument("--bot", action="store_true")
    p.set_defaults(func=cmd_inject)

    p = sub.add_parser("timeline")
    p.add_argument("--db", default=argparse.SUPPRESS)
    p.add_argument("--conversation", required=True)
    p.add_argument("--limit", default=None)
    p.set_defaults(func=cmd_timeline)

    p = sub.add_parser("conversations")
    p.add_argument("--db", default=argparse.SUPPRESS)
    p.set_defaults(func=cmd_conversations)

    p = sub.add_parser("get")
    p.add_argument("--db", default=argparse.SUPPRESS)
    p.add_argument("--conversation", required=True)
    p.add_argument("--id", required=True)
    p.set_defaults(func=cmd_get)

    p = sub.add_parser("outbox")
    p.add_argument("--conversation", default=None)
    p.add_argument("--after", default="0")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_outbox)

    args = ap.parse_args()
    c = conn(db_path(args))
    rc = args.func(c, args)
    c.close()
    return rc


if __name__ == "__main__":
    sys.exit(main())
