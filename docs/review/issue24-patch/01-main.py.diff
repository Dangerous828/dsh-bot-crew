 @app.get("/healthz")
 async def healthz() -> dict[str, str]:
+    # 通用探针保持原样：外部监控/容器 healthcheck 只认 status/service/version，
+    # 兼容面状态只加在 /v1/health 上（那是宿主机客户端读的那一条）。
     return {"status": "ok", "service": "home-agent-hub", "version": "1.0.0"}
 
 
+# dsh-bot-crew#24: 宿主机探测打的是 `GET <hub>/health`（无 header，2xx 即可达），
+# 而 `/v1` router 上挂着 require_token —— 探测没有 token，必然 401 被判「无中枢」，
+# 记忆就永远静默退回本机版。所以在 **app 级**（不经 router 依赖）加一条免鉴权探针。
+#
+# 为什么是 `/v1/health` 而不是根 `/health`：公网 Caddy 只把 `/v1/*` 与 `/healthz`
+# 反代到 hub-api（`jarvis/deploy/caddy/Caddyfile`），根路径 `/health` 会落到前端
+# catch-all 返回 200 HTML —— 那是「假通」，探测永远成功但调用全 405，比 401 更难查。
+# 挂 `/v1/health` 正好命中现成的 `/v1/*` 反代，零 Caddy 改动。
+# 宿主机侧因此把 `memory.hub` 填成 `https://jarvis.kentonnie.top/v1`。
+# 响应与 /healthz 等价，另加 `memory_compat` 字段如实报兼容面注册状态：
+# 模块导入失败时旧实现照样回 `{"status":"ok"}`，探针 200 → 客户端认为中枢可用，
+# 每次召回都 404 后静默降级本机，运维只看得到「hub reached」。
+# 兼容面挂掉不等于整个 hub 挂掉，所以通用 `status` 仍是 `ok`；否定信息放在
+# `memory_compat` 里，让探针/面板能单独判读，既有按 service/version 断言的
+# 外部消费者一个字段都不少。
+MEMORY_COMPAT_STATUS = "unknown"
+
+
+def health_payload(memory_compat: str | None = None) -> dict[str, str]:
+    """健康响应。`memory_compat` 缺省取模块级实际注册结果。"""
+    return {
+        "status": "ok",
+        "service": "home-agent-hub",
+        "version": "1.0.0",
+        "memory_compat": memory_compat if memory_compat is not None else MEMORY_COMPAT_STATUS,
+    }
+
+
+@app.get("/v1/health")
+async def v1_health() -> dict[str, str]:
+    return health_payload()
+
+
