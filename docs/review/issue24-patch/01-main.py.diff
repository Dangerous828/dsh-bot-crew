     _logging.getLogger(__name__).warning("metrics routes not registered: %s", _metrics_reg_exc)
 
+# dsh-bot-crew#24: 记忆中枢兼容面 /v1/memory/{search,consolidate}。
+# 不改 /v1 既有 API；契约见 backend/docs/08-memory-hub.md（宿主机侧）。
+try:
+    from .memory_compat_routes import register_memory_compat_routes
+
+    register_memory_compat_routes(router, session_type=Session)
+    MEMORY_COMPAT_STATUS = "registered"
+except Exception as _compat_reg_exc:  # noqa: BLE001 — 兼容面缺失不阻断 hub 启动
+    import logging as _logging
+
+    # 如实记下失败原因，`/v1/health` 会把它报出去（见 health_payload）。
+    MEMORY_COMPAT_STATUS = f"unavailable:{type(_compat_reg_exc).__name__}"
+    _logging.getLogger(__name__).warning("memory compat routes not registered: %s", _compat_reg_exc)
+
 
